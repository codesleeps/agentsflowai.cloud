# AgentsFlowAI Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# REQUIRED - Application will not work without these
# ============================================================================

# Database connection string (PostgreSQL with SSL)
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Public URL of your application
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Application port
PORT=3000

# ============================================================================
# AI PROVIDERS - At least one is required for AI functionality
# ============================================================================

# OpenAI API Key (for GPT models)
# Get from: https://platform.openai.com/api-keys
# Renew if expired: https://platform.openai.com/api-keys
# Note: Keys may expire - check /api/ai/health-check if models fail
OPENAI_API_KEY=

# Anthropic API Key (for Claude models)
# Get from: https://console.anthropic.com/
# Renew if expired: https://console.anthropic.com/settings/keys
# Note: Keys may expire - check /api/ai/health-check if models fail
ANTHROPIC_API_KEY=

# Google Generative AI API Key (for Gemini models)
# Get from: https://makersuite.google.com/app/apikey
# Renew if expired: https://makersuite.google.com/app/apikey
# Note: Keys may expire - check /api/ai/health-check if models fail
GOOGLE_API_KEY=

# OpenRouter API Key (for accessing multiple AI models through one API)
# Get from: https://openrouter.ai/keys
# Renew if expired: https://openrouter.ai/keys
# Note: Keys may expire - check /api/ai/health-check if models fail
OPENROUTER_API_KEY=

# Ollama Base URL (for local AI models - no API key required)
# Default: http://localhost:11434
# Install from: https://ollama.com
# Note: Requires Ollama to be running locally with 'ollama serve'
OLLAMA_BASE_URL=http://localhost:11434

# Deprecated: Use GOOGLE_API_KEY instead
# GOOGLE_GENERATIVE_AI_API_KEY=

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# Session secret for encrypting session data
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Better Auth configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ============================================================================
# BACKGROUND JOBS (Inngest)
# ============================================================================

# Inngest event key
# Get from: https://app.inngest.com/
INNGEST_EVENT_KEY=

# Inngest signing key
INNGEST_SIGNING_KEY=

# ============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================================

# Twilio (for SMS/Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email service (required for password reset functionality)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ============================================================================
# MONITORING & ANALYTICS (Optional)
# ============================================================================

# Sentry DSN (for error tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Enable debug logging
DEBUG=false

# Skip authentication (development only - NEVER in production)
SKIP_AUTH=false

# ============================================================================
# TROUBLESHOOTING & DIAGNOSTICS
# ============================================================================

# Health Check Endpoint
# Check provider status: GET /api/ai/health-check
# Returns detailed diagnostics about API key status and model availability

# Common Issues:
# 1. "API Key Expired" errors
#    - Check the health endpoint for renewal URLs
#    - Update the expired key in this file
#    - Restart the application
#
# 2. "Provider Unavailable" errors  
#    - Verify API keys are correctly set
#    - Check provider service status
#    - Review startup logs for validation warnings
#
# 3. Ollama connection errors
#    - Ensure Ollama is running: ollama serve
#    - Verify OLLAMA_BASE_URL is correct
#    - Check that required models are pulled
#
# 4. All providers failing
#    - Check /api/ai/health-check for detailed diagnostics
#    - Review application logs for startup validation
#    - Verify at least one provider is configured correctly
