# AgentsFlowAI Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# DOCKER DEPLOYMENT
# ============================================================================
#
# IMPORTANT: For Docker deployments, environment variables should be passed
# at RUNTIME, not baked into the image during build.
#
# Build-time variables (only NEXT_PUBLIC_* variables):
#   docker build \
#     --build-arg NEXT_PUBLIC_APP_URL=https://yourdomain.com \
#     --build-arg NEXT_PUBLIC_GA_ID=GA-XXXXX \
#     -t agentsflowai:latest .
#
# Runtime variables (all sensitive/config variables):
#   docker run -p 3000:3000 --env-file .env.production agentsflowai:latest
#
# Or pass individual variables:
#   docker run -p 3000:3000 \
#     -e DATABASE_URL="postgresql://..." \
#     -e SESSION_SECRET="..." \
#     -e OPENAI_API_KEY="..." \
#     agentsflowai:latest
#
# Security best practices:
#   - NEVER copy .env files into Docker images
#   - Use Docker secrets or environment variables for sensitive data
#   - Only NEXT_PUBLIC_* variables are safe to bake into images
#   - Runtime variables allow different configs per environment
#
# Health check:
#   curl http://localhost:3000/api/health
#
# ============================================================================
# DOCKER COMPOSE DEPLOYMENT
# ============================================================================
#
# Use Docker Compose for simplified local development and production deployment.
# Docker Compose automatically orchestrates both the Next.js app and Ollama service.
#
# Development mode (with hot-reload):
#   docker-compose -f docker-compose.yml -f docker-compose.dev.yml up
#   Or use npm script: npm run docker:dev
#
# Production deployment:
#   1. Copy .env.production.template to .env
#   2. Edit .env with production values
#   3. Run: ./deploy/docker-deploy.sh
#   Or manually: docker-compose -f docker-compose.prod.yml up -d
#
# Production-like mode (for testing):
#   docker-compose up -d
#   Or use npm script: npm run docker:up
#
# Pull Ollama models (after containers are running):
#   npm run docker:ollama:pull
#   This pulls mistral:7b, llama3.1:8b, and gemma2:9b
#
# Important Docker Compose Notes:
#   - OLLAMA_BASE_URL is automatically set to http://ollama:11434 in Docker Compose
#   - The .env file is automatically loaded by docker-compose.yml
#   - Services communicate via the internal Docker network 'agentsflowai-network'
#   - Ollama models are persisted in the 'ollama-models' volume
#   - For development, source code is bind-mounted for hot-reload
#   - Production uses docker-compose.prod.yml with resource limits and security features
#
# Useful commands:
#   npm run docker:build       - Build Docker images
#   npm run docker:up          - Start services in background
#   npm run docker:down        - Stop and remove containers
#   npm run docker:logs        - View logs from all services
#   npm run docker:clean       - Remove containers and volumes
#
# Production commands:
#   ./deploy/docker-deploy.sh  - Deploy to production server
#   docker-compose -f docker-compose.prod.yml ps     - Check status
#   docker-compose -f docker-compose.prod.yml logs   - View logs
#   docker-compose -f docker-compose.prod.yml restart - Restart services
#
# ============================================================================
# REQUIRED - Application will not work without these
# ============================================================================

# Database connection string (PostgreSQL with SSL)
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Public URL of your application
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Application port
PORT=3000

# ============================================================================
# AI PROVIDERS - At least one is required for AI functionality
# ============================================================================

# OpenAI API Key (Optional - for GPT models)
# Get from: https://platform.openai.com/api-keys
# Renew if expired: https://platform.openai.com/api-keys
# Note: Keys may expire - check /api/ai/health-check if models fail
OPENAI_API_KEY=

# Anthropic API Key (Optional - for Claude models)
# Get from: https://console.anthropic.com/
# Renew if expired: https://console.anthropic.com/settings/keys
# Note: Keys may expire - check /api/ai/health-check if models fail
ANTHROPIC_API_KEY=

# Google Generative AI API Key (Optional - for Gemini models)
# Get from: https://makersuite.google.com/app/apikey
# Renew if expired: https://makersuite.google.com/app/apikey
# Note: Keys may expire - check /api/ai/health-check if models fail
GOOGLE_API_KEY=

# OpenRouter API Key (Optional - for accessing multiple AI models through one API)
# Get from: https://openrouter.ai/keys
# Renew if expired: https://openrouter.ai/keys
# Note: Keys may expire - check /api/ai/health-check if models fail
OPENROUTER_API_KEY=

# Ollama Base URL (for local AI models - no API key required)
# Default: http://localhost:11434
# Install from: https://ollama.com
# Note: Requires Ollama to be running locally with 'ollama serve'
OLLAMA_BASE_URL=http://localhost:11434

# Enable automatic model warmup on application startup
# Set to 'true' to pre-load Ollama models on startup
# This eliminates 10-30s first-request latency but increases startup time by 10-20s
# Recommended for production deployments
OLLAMA_WARMUP_ON_STARTUP=false

# Deprecated: Use GOOGLE_API_KEY instead
# GOOGLE_GENERATIVE_AI_API_KEY=

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# Session secret for encrypting session data
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Better Auth configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ============================================================================
# BACKGROUND JOBS (Inngest)
# ============================================================================

# Inngest event key
# Get from: https://app.inngest.com/
INNGEST_EVENT_KEY=

# Inngest signing key
INNGEST_SIGNING_KEY=

# ============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================================

# Twilio (for SMS/Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email service (required for password reset functionality)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ============================================================================
# MONITORING & ANALYTICS (Optional)
# ============================================================================

# Sentry DSN (for error tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Enable debug logging
DEBUG=false

# Skip authentication (development only - NEVER in production)
SKIP_AUTH=false

# ============================================================================
# TROUBLESHOOTING & DIAGNOSTICS
# ============================================================================

# Health Check Endpoint
# Check provider status: GET /api/ai/health-check
# Returns detailed diagnostics about API key status and model availability

# Common Issues:
# 1. "API Key Expired" errors
#    - Check the health endpoint for renewal URLs
#    - Update the expired key in this file
#    - Restart the application
#
# 2. "Provider Unavailable" errors  
#    - Verify API keys are correctly set
#    - Check provider service status
#    - Review startup logs for validation warnings
#
# 3. Ollama connection errors
#    - Ensure Ollama is running: ollama serve
#    - Verify OLLAMA_BASE_URL is correct
#    - Check that required models are pulled
#
# 4. All providers failing
#    - Check /api/ai/health-check for detailed diagnostics
#    - Review application logs for startup validation
#    - Verify at least one provider is configured correctly
