{
  "name": "agentsflowai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "25.6.1"
  },
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts",
    "dev": "next dev",
    "REMOVE_MEpostinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest --passWithNoTests --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:integration": "jest --testPathPattern=integration",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:fallback": "jest --testPathPatterns=fallback-chain.test.ts",
    "test:ai-providers": "tsx scripts/test-ai-providers.ts",
    "mcp:health": "tsx scripts/check-mcp-health.ts",
    "mcp:test": "tsx scripts/test-mcp-connections.ts",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "disk-usage": "used=$(du -sm / | cut -f1); total=$(stat -f -c \"%b %S\" / | awk '{print $1*$2/1048576}'); echo \"Total: ${total%.*} MB, Used: ${used} MB, Free: $(( ${total%.*} - used )) MB\"",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml build",
    "docker:dev:down": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:clean": "docker-compose down -v",
    "docker:ollama:pull": "docker-compose exec ollama ollama pull mistral:7b && docker-compose exec ollama ollama pull gemma2:9b && docker-compose exec ollama ollama pull codellama:7b",
    "docker:ollama:warmup": "docker-compose exec ollama sh -c 'ollama run mistral:7b \"test\" && ollama run gemma2:9b \"test\" && ollama run codellama:7b \"test\"'",
    "docker:ollama:status": "docker-compose exec ollama ollama list",
    "docker:ollama:pull:all": "npm run docker:ollama:pull",
    "warmup:ollama": "tsx scripts/warmup-ollama.ts",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:prod:restart": "docker-compose -f docker-compose.prod.yml restart",
    "docker:prod:ps": "docker-compose -f docker-compose.prod.yml ps",
    "docker:prod:pull": "docker-compose -f docker-compose.prod.yml pull",
    "health:check": "bash scripts/health-check.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.22.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "^6.3.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-table": "^8.21.2",
    "@tiptap/pm": "^3.3.1",
    "@tiptap/react": "^3.3.1",
    "@tiptap/starter-kit": "^3.3.1",
    "@types/json-schema": "^7.0.15",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.13.2",
    "better-auth": "^1.4.9",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.5.2",
    "inngest": "^3.22.13",
    "lucide-react": "^0.474.0",
    "next": "^15.5.7",
    "next-themes": "^0.4.4",
    "nodemailer": "^7.0.12",
    "openai": "^4.104.0",
    "pg": "^8.16.3",
    "react": "^19.2.1",
    "react-big-calendar": "^1.19.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.69.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.1",
    "redis": "^4.7.1",
    "sonner": "^2.0.1",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tiptap": "^0.15.0",
    "twilio": "^5.11.1"
  },
  "optionalDependencies": {
    "@next/swc-linux-arm64-gnu": "~15.5.7",
    "@next/swc-linux-arm64-musl": "~15.5.7",
    "@next/swc-linux-x64-gnu": "~15.5.7",
    "@next/swc-linux-x64-musl": "~15.5.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.1",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "packageManager": "npm@10.6.0",
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true,
        "skipAsyncImports": true
      },
      "tsx": {
        "skipTypeImports": true,
        "skipAsyncImports": true
      }
    }
  },
  "overrides": {
    "minimatch": "^10.0.1",
    "glob": "^12.0.0",
    "inflight": "npm:@jsdevtools/inflight@^2.0.0"
  }
}
